# syntax=docker/dockerfile:1.7
# Local development only: compose.yaml mounts the source at /app.
# Rebuild when pyproject.toml, uv.lock or this image's setup changes.
FROM python:3.14.10-slim-trixie@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f

COPY --from=astral/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /bin/uv

# Keep Linux dependencies outside /app so the bind mount never hides them or uses the host's .venv.
ENV DJANGO_SETTINGS_MODULE=config.settings.local \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    UV_CACHE_DIR=/root/.cache/uv uv sync --locked --no-install-project

# Reuse the production startup modes, but keep the executable outside the host mount too.
COPY --chmod=0755 entrypoint.sh /usr/local/bin/glowderma-entrypoint
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --no-create-home --home-dir /tmp --shell /usr/sbin/nologin app

USER 10001:10001
EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/glowderma-entrypoint"]
CMD ["api", "--reload", "--reload-engine", "poll", "--workers", "1"]
