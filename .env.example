DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-secret-key-at-least-32-characters
INTERNAL_API_SECRET=change-me-internal-secret-at-least-32-characters
# JSON object {kid: base64url(32+ random bytes)}; generate a value with
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
JWT_SIGNING_KEYS={"dev":"4zhPFokAL4QMFGTQpn-XIhwA3i4TYB9SgcekVIfjG2U"}
JWT_ACTIVE_KID=dev
DATABASE_URL=postgres://glowderma:change-me-password@localhost:5433/glowderma
# Redis DB 0 is the Django cache, DB 1 the Celery broker (defaults to REDIS_URL with the path replaced by /1).
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_API_ALLOWED_NETS=127.0.0.0/8,::1/128
DJANGO_ADMIN_ENABLED=true
GIT_SHA=dev
# Provider adapters: fake (in-process stubs, default) or live.
INTEGRATIONS_MODE=fake
# Absolute base for media URLs (never derived from the request Host).
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8000/media/

# ---- Staff social sign-in (M0b) ------------------------------------------------
# fake = deterministic in-process providers (codes "fake:<subject>:<email>", see integrations/oauth/fake.py),
# live = Google + Facebook; defaults to INTEGRATIONS_MODE. In production, live requires every value below
# (except GOOGLE_ALLOWED_HD and STAFF_GOOGLE_AUTOLINK) with real credentials.
OAUTH_MODE=fake
# The Next admin's OAuth callback URL; when set, the request body's redirect_uri must equal it.
#OAUTH_REDIRECT_URI=https://admin.example.uz/admin/auth/callback
# Google OAuth web client (Google Cloud console -> APIs & Services -> Credentials).
#GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
#GOOGLE_OAUTH_CLIENT_SECRET=change-me-google-client-secret
# Only accept Google accounts of this Workspace domain (ID token "hd" claim); empty = any Google account.
#GOOGLE_ALLOWED_HD=
# Auto-link a Google identity on first sign-in to the active staff user with the same verified email
# (@gmail.com or hd == email domain). Default false: identities are linked by a signed-in staff member.
#STAFF_GOOGLE_AUTOLINK=false
# Facebook app (developers.facebook.com -> App settings -> Basic).
#FACEBOOK_APP_ID=change-me-facebook-app-id
#FACEBOOK_APP_SECRET=change-me-facebook-app-secret
#FACEBOOK_GRAPH_VERSION=v21.0

# ---- Billz (M1a) ---------------------------------------------------------------
# fake = deterministic in-process Billz (import yields three NEW products, see integrations/billz/fake.py),
# live = the Billz API client (M3); defaults to INTEGRATIONS_MODE.
#BILLZ_MODE=fake

# ---- Optional ----------------------------------------------------------------
# Reverse proxies whose X-Forwarded-For / X-GD-Client-IP may be trusted (CIDRs, comma separated).
#TRUSTED_PROXIES=10.0.0.0/8
# Production only: TLS normally terminates at the edge proxy, so both stay off unless Django faces the client.
#SECURE_SSL_REDIRECT=false
#SECURE_HSTS_SECONDS=0
# With SECURE_HSTS_SECONDS > 0, includeSubDomains is on by default and preload stays OFF: preload commits the
# host AND every subdomain to HTTPS in browser preload lists and is practically irreversible. Opt in only after
# confirming every subdomain serves HTTPS (`check --deploy` warns security.W021 until you do).
#SECURE_HSTS_INCLUDE_SUBDOMAINS=true
#SECURE_HSTS_PRELOAD=true
# Gunicorn (gthread): processes x threads.
#GUNICORN_WORKERS=3
#GUNICORN_THREADS=4
# psycopg connection pool (default: true in production, false in local/test).
#DB_POOL=true
# Level of the glowderma.* loggers (DEBUG, INFO, WARNING, ERROR, CRITICAL); default INFO, DEBUG in local.
#LOG_LEVEL=INFO
# Per-scope throttle overrides (contract §1.9), JSON object of DRF rates.
#THROTTLE_RATES={"login":"30/min","staff":"1200/min"}
# Local/staging only: password of the demo staff account admin@glowderma.uz created by `manage.py seed_demo`.
#SEED_ADMIN_PASSWORD=glowderma-demo-2026
