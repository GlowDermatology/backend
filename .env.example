CELERY_BROKER_URL=redis://localhost:6380/0
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_API_ALLOWED_NETS=127.0.0.0/8,::1/128
DJANGO_ADMIN_ENABLED=true
GIT_SHA=dev
