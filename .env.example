DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-secret-key-at-least-32-characters
INTERNAL_API_SECRET=change-me-internal-secret-at-least-32-characters
# JSON object {kid: base64url(32+ random bytes)}; generate a value with
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
JWT_SIGNING_KEYS={"dev":"4zhPFokAL4QMFGTQpn-XIhwA3i4TYB9SgcekVIfjG2U"}
JWT_ACTIVE_KID=dev
DATABASE_URL=postgres://glowderma:change-me-password@localhost:5433/glowderma
# Redis DB 0 is the Django cache, DB 1 the Celery broker (defaults to REDIS_URL with the path replaced by /1).
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_API_ALLOWED_NETS=127.0.0.0/8,::1/128
DJANGO_ADMIN_ENABLED=true
GIT_SHA=dev
# Provider adapters: fake (in-process stubs, default) or live.
INTEGRATIONS_MODE=fake
# Absolute base for media URLs (never derived from the request Host).
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8000/media/

# ---- Optional ----------------------------------------------------------------
# Reverse proxies whose X-Forwarded-For / X-GD-Client-IP may be trusted (CIDRs, comma separated).
#TRUSTED_PROXIES=10.0.0.0/8
# Production only: TLS normally terminates at the edge proxy, so both stay off unless Django faces the client.
#SECURE_SSL_REDIRECT=false
#SECURE_HSTS_SECONDS=0
# With SECURE_HSTS_SECONDS > 0, includeSubDomains is on by default and preload stays OFF: preload commits the
# host AND every subdomain to HTTPS in browser preload lists and is practically irreversible. Opt in only after
# confirming every subdomain serves HTTPS (`check --deploy` warns security.W021 until you do).
#SECURE_HSTS_INCLUDE_SUBDOMAINS=true
#SECURE_HSTS_PRELOAD=true
# Gunicorn (gthread): processes x threads.
#GUNICORN_WORKERS=3
#GUNICORN_THREADS=4
# psycopg connection pool (default: true in production, false in local/test).
#DB_POOL=true
# Level of the glowderma.* loggers (DEBUG, INFO, WARNING, ERROR, CRITICAL); default INFO, DEBUG in local.
#LOG_LEVEL=INFO
# Per-scope throttle overrides (contract §1.9), JSON object of DRF rates.
#THROTTLE_RATES={"login":"30/min","staff":"1200/min"}
