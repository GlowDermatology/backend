# Production .env for compose.prod.yaml (M3 backend). Runbook: docs/ops/deploy.md.
#
#   cp deploy/env.production.example .env && chmod 600 .env      (next to compose.prod.yaml; never commit it)
#
# Compose reads this file twice: for ${...} interpolation in compose.prod.yaml, and as the env_file of the api,
# worker and beat containers (every line below reaches Django). The frontend gets only what compose.prod.yaml
# passes it explicitly.
#
# A copied, unedited example never boots: the three infrastructure passwords are empty and compose.prod.yaml
# refuses to start without them (before PostgreSQL or Redis is initialised), and every other required secret is
# a "change-me" placeholder that config.settings.production refuses, as it refuses the values committed to this
# repository, short keys and malformed ones (the error names the variable, never the value). Commented
# placeholders of the live provider blocks are refused the same way once their *_MODE is live. The image tags
# (GIT_SHA, FRONTEND_GIT_SHA) are appended by deploy/pin-release.sh at every release.
#
# Format rules (Compose dotenv): one NAME=value per line, no spaces around "=", LF line endings. Compose
# interpolates "$" in values: a provider-issued value that contains "$" is written with "$$" for each "$", or
# wrapped in single quotes ('...' is taken literally and the quotes are stripped). The generators given below
# only produce [A-Za-z0-9_-] values.
#
# Legend of each entry: what it is · required? (and under which *_MODE) · default · secret? · how to generate.
#   Active line (NAME=value)  = set it.     Commented line (#NAME=value) = optional; uncomment to change.
#   "# NAME — ..." line        = documented only: set by compose.prod.yaml, or refused by production.

# =============================================================================================================
# 0. Domains and the Compose stack (read by compose.prod.yaml, not by Django)
# =============================================================================================================
# Public landing page (Next.js); www.SITE_DOMAIN redirects to it. Required (compose refuses to start without it).
# Also the frontend's NEXT_PUBLIC_SITE_URL (baked at build time: rebuild after a change).
SITE_DOMAIN=glowderma.uz
# Admin panel host (Next.js BFF). Required. Also the frontend's GLOWDERMA_ALLOWED_ORIGINS and the base of the
# staff OAuth callback URLs compose derives (GOOGLE_/FACEBOOK_OAUTH_REDIRECT_URI).
ADMIN_DOMAIN=admin.glowderma.uz
# Public Django host: mobile customer API, Click/Payme/BTS webhooks, POS, health, /media/. Required. Also
# ALLOWED_HOSTS, PUBLIC_MEDIA_BASE_URL and the frontend's GLOWDERMA_MEDIA_HOSTS (derived by compose).
API_DOMAIN=api.glowderma.uz
# Let's Encrypt account e-mail (certificate expiry notices). Required.
ACME_EMAIL=ops@glowderma.uz
# Host directory mounted read-only at /run/secrets/glowderma in the api, worker and beat containers; it holds
# the files FCM_CREDENTIALS_FILE and APPLE_PRIVATE_KEY_FILE point at. Optional · default /srv/glowderma/secrets.
# Keep it outside the git checkout, owned by root, group 10001 (the image's "app" user), dir 0750, files 0440.
#GLOWDERMA_SECRETS_DIR=/srv/glowderma/secrets
# Path of the frontend repository checkout used as the frontend image build context. Optional · default
# ../frontend (relative to compose.prod.yaml).
#FRONTEND_CONTEXT=../frontend
# FRONTEND_GIT_SHA — written to .env by deploy/pin-release.sh (the frontend checkout's short commit); it tags the frontend image and becomes its /healthz version. Required (compose refuses to start without it); never edit by hand.
# Memory limits of the api, worker and frontend containers (Docker units: 768m, 1g ...). Optional · defaults
# 1g / 1g / 768m, sized for a 2 vCPU / 4 GB host; raise WORKER_MEM_LIMIT with CELERY_CONCURRENCY (about 150 MB
# per process). A container above its limit has one process killed and restarted, not the host.
#API_MEM_LIMIT=1g
#WORKER_MEM_LIMIT=1g
#FRONTEND_MEM_LIMIT=768m

# =============================================================================================================
# 1. Core and security (config.settings.production)
# =============================================================================================================
# DJANGO_SETTINGS_MODULE — set by compose.prod.yaml (config.settings.production); do not set.
# GIT_SHA — set by compose.prod.yaml from the GIT_SHA line deploy/pin-release.sh writes to .env (the backend checkout's short commit: the backend image tag and the health "version"). Required (compose refuses to start without it); never edit by hand.
#
# Django signing key (sessions, signed values). Required · secret · >= 32 characters; "change-me" and committed
# values are refused. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-50-byte-urlsafe-secret
# Shared secret between the Next BFF and Django (header X-GD-Internal-Secret; also the root of the frontend's
# OAuth flow-cookie key). Required · secret · >= 32 characters. Compose hands it to the frontend as
# GLOWDERMA_INTERNAL_SECRET. Rotating it signs every staff user out of the admin panel.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=change-me-generate-a-48-byte-urlsafe-secret
# Staff JWT signing keys: JSON object {kid: base64url(>= 32 random bytes)}. Required · secret. Rotate by adding a
# new kid, switching JWT_ACTIVE_KID to it, and removing the old kid after the access lifetime (15 min).
# Generate one key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SIGNING_KEYS={"k1":"change-me"}
# The kid of JWT_SIGNING_KEYS that signs new tokens. Required · not secret.
JWT_ACTIVE_KID=k1
# ALLOWED_HOSTS — set by compose.prod.yaml (API_DOMAIN and "api"; production appends localhost for the container healthcheck); do not set.
# ADMIN_API_ALLOWED_NETS — set by compose.prod.yaml (172.30.0.20/32: only the frontend container reaches /api/v1/admin/, /schema/, /docs/, /django-admin/, plus the internal secret); do not set.
# TRUSTED_PROXIES — set by compose.prod.yaml (172.30.0.10/32: only the edge's X-Forwarded-For is trusted; per-IP throttles and the Click/Payme IP allow-lists depend on it); do not set.
# Django admin at /django-admin/ (read-only; reachable only from ADMIN_API_ALLOWED_NETS with the internal secret,
# i.e. not from the internet). Optional · default false.
DJANGO_ADMIN_ENABLED=false
# TLS terminates at the edge (Caddy); Django sees plain HTTP from it. Keep false unless Django faces clients.
# Optional · default false.
#SECURE_SSL_REDIRECT=false
# Django's own Strict-Transport-Security. Optional · default 0 (off): the edge already sends
# "max-age=31536000" on every host, so a second policy is avoided (check --deploy then reports security.W004).
SECURE_HSTS_SECONDS=0
# Only with SECURE_HSTS_SECONDS > 0. includeSubDomains defaults to on with HSTS; preload is an explicit,
# practically irreversible opt-in (check --deploy warns security.W021 until it is set). Optional.
#SECURE_HSTS_INCLUDE_SUBDOMAINS=true
#SECURE_HSTS_PRELOAD=false
# Level of the glowderma.* loggers: DEBUG, INFO, WARNING, ERROR, CRITICAL. Optional · default INFO.
LOG_LEVEL=INFO
# Per-scope DRF throttle overrides (contract §1.9), a JSON object validated at startup. Optional · default {}
# (the rates of glowderma/core/throttling.py).
#THROTTLE_RATES={"login":"30/min","staff":"1200/min"}
# Gunicorn gthread: processes x threads per api container (about 2 x vCPU processes). Optional · defaults 3 / 4.
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
# Local/test switches. config.settings.production refuses to start when any of them is set, to ANY value:
# FAKE_NOW — refused by the production settings (pins the clock for demos/e2e); never set.
# FAKE_PAYMENTS_ENABLED — refused by the production settings (dev simulate endpoint); never set.
# FAKE_SCENARIO_HEADER_ENABLED — refused by the production settings (fake scenario header); never set.
# ESKIZ_FAKE_CODE — refused by the production settings (fixed OTP of the fake Eskiz and fake e-mail); never set.
# POS_API_KEYS — refused by the production settings (seeded POS keys); production POS keys come from manage.py createposkey.
# Password of the demo staff account admin@glowderma.uz that `manage.py seed_demo --force` creates (staging
# only; production never runs seed_demo). Required whenever seed_demo runs under these settings: a staging stack
# is internet-facing, so seed_demo refuses to create the account without it, with fewer than 12 characters or
# with the committed demo password. Secret. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
#SEED_ADMIN_PASSWORD=

# =============================================================================================================
# 2. Database, Redis, Celery
# =============================================================================================================
# Password of the PostgreSQL superuser "glowderma" (administration only: psql, pg_dump, pg_restore inside the
# postgres container). Compose initialises the postgres volume with it. Required · secret · compose refuses an
# empty value. The volume keeps the first password: changing it later needs ALTER ROLE glowderma inside
# postgres (or, on a fresh install only, docker volume rm glowderma_pgdata). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Password of "glowderma_app", the role the application connects as: it owns the database but is not a
# superuser (deploy/postgres/app-role.psql creates it on an empty volume; docs/ops/deploy.md §5 for an existing
# one). Required · secret · hex only (it is embedded in DATABASE_URL) · compose refuses an empty value and
# production a "change-me". To change it: edit, `up -d postgres`, run deploy/postgres/10-app-role.sh in the
# postgres container, then `up -d` (deploy.md §14). Generate: openssl rand -hex 24
POSTGRES_APP_PASSWORD=
# DATABASE_URL — set by compose.prod.yaml (postgres://glowderma_app:${POSTGRES_APP_PASSWORD}@postgres:5432/glowderma); do not set.
# Redis password (requirepass; the postgres and redis containers are on a network the edge and the frontend
# cannot reach, this is the second lock). Required · secret · hex only (it is embedded in the Redis URLs) ·
# compose refuses an empty value. Generate: openssl rand -hex 24
REDIS_PASSWORD=
# REDIS_URL — set by compose.prod.yaml (redis://:${REDIS_PASSWORD}@redis:6379/0: DB 0 is the Django cache); do not set.
# CELERY_BROKER_URL — set by compose.prod.yaml (redis://:${REDIS_PASSWORD}@redis:6379/1: DB 1 is the Celery broker); do not set.
# Redis memory ceiling (noeviction: above it writes fail visibly; queued tasks are never dropped). Optional ·
# default 256mb.
#REDIS_MAXMEMORY=256mb
# psycopg connection pool per process (min 1, max 4). Optional · default true.
#DB_POOL=true
# Celery worker processes (compose: worker --concurrency). Optional · default 4. Keep at least 3: long periodic
# jobs (BTS polling <= 5 min, the consistency report <= 9 min, Billz syncs, retention <= 5 min) each hold a
# process while the outbox dispatcher (OTP SMS, pushes, Billz sales, refunds) needs a free one.
CELERY_CONCURRENCY=4

# =============================================================================================================
# 3. Media
# =============================================================================================================
# PUBLIC_MEDIA_BASE_URL — set by compose.prod.yaml (https://API_DOMAIN/media/; the edge serves the media volume there); do not set.

# =============================================================================================================
# 4. Staff sign-in: Google / Facebook (admin contract 2.1)
# =============================================================================================================
# fake | live. Optional · default INTEGRATIONS_MODE. Under the production settings fake disables social sign-in
# (staff and customers; password and SMS sign-in still work). live requires every credential below (production
# refuses to start otherwise) and STAFF_OAUTH_PROVIDERS for the admin buttons. Set OAUTH_MODE=fake explicitly
# when INTEGRATIONS_MODE=live but social sign-in is not configured yet (deploy.md §9 "Social sign-in").
#OAUTH_MODE=fake
# Admin login buttons: comma list of google, facebook (compose passes it to the frontend as
# GLOWDERMA_OAUTH_PROVIDERS, with OAUTH_MODE as GLOWDERMA_OAUTH_MODE and the two public client ids below).
# Optional · default empty (no social buttons).
#STAFF_OAUTH_PROVIDERS=google,facebook
# Google OAuth web client (Google Cloud console → APIs & Services → Credentials). Required when OAUTH_MODE=live.
# The id is public (also sent to the frontend); the secret is secret.
#GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
#GOOGLE_OAUTH_CLIENT_SECRET=change-me-google-client-secret
# Only accept Google accounts of this Workspace domain (ID token "hd"); empty = any Google account. Optional.
#GOOGLE_ALLOWED_HD=glowderma.uz
# Auto-link a Google identity on first sign-in to the active staff user with the same verified e-mail
# (@gmail.com, or hd == the e-mail's domain). Optional · default false.
#STAFF_GOOGLE_AUTOLINK=false
# Facebook app (developers.facebook.com → App settings → Basic). Required when OAUTH_MODE=live. The id is
# public (also sent to the frontend); the secret is secret.
#FACEBOOK_APP_ID=change-me-facebook-app-id
#FACEBOOK_APP_SECRET=change-me-facebook-app-secret
# Graph API version of the live Facebook adapter. Optional · default v21.0 (the frontend's dialog uses v21.0).
#FACEBOOK_GRAPH_VERSION=v21.0
# GOOGLE_OAUTH_REDIRECT_URI — set by compose.prod.yaml (https://ADMIN_DOMAIN/admin/auth/oauth/google/callback, the BFF callback: register exactly this URL with Google); do not set.
# FACEBOOK_OAUTH_REDIRECT_URI — set by compose.prod.yaml (https://ADMIN_DOMAIN/admin/auth/oauth/facebook/callback: register exactly this URL with Facebook); do not set.
# OAUTH_REDIRECT_URI — deprecated single callback URL of M0b (the fallback of an empty per-provider URI); compose sets both per-provider URIs, so leave it unset.

# =============================================================================================================
# 5. Customer API (M2): keys, sessions, OTP, cart and checkout, QR/POS, appointments
# =============================================================================================================
# HMAC key of stored SMS codes. Required in every mode · secret · >= 32 characters. Rotating it invalidates the
# codes in flight (<= 2 min). Generate: openssl rand -hex 32
SMS_CODE_HMAC_KEY=change-me
# HMAC key of the pseudonymous phone/device references (pii_ref) in logs and throttle keys. Required · secret ·
# >= 32 characters. Rotating it resets the per-phone counters and breaks log correlation across the change.
# Generate: openssl rand -hex 32
LOG_PII_KEY=change-me
# HMAC key of the provider account reference "<order_id>-<ref>" Click and Payme send back. Required · secret ·
# >= 32 characters. Never rotate while payments are open: their callbacks would no longer verify.
# Generate: openssl rand -hex 32
PAYMENT_REF_KEY=change-me
# HMAC key of the loyalty QR token store and the POS customer_ref. Required · secret · >= 32 characters.
# Rotating it voids live QR codes (60 s) and changes every customer_ref POS devices saw.
# Generate: openssl rand -hex 32
QR_HMAC_KEY=change-me
# AES-256-GCM key of core.secretbox (the OTP sealed in Redis, Apple refresh tokens): base64url of EXACTLY
# 32 bytes. Required · secret. Never rotate: sealed Apple tokens could no longer be revoked.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRETBOX_KEY=change-me
# Access JWT lifetime (s), sliding refresh window (days), refresh replay grace (s), unconfirmed re-rotation
# window (s). Optional · defaults 900 / 60 / 120 / 600.
#CUSTOMER_ACCESS_TTL=900
#CUSTOMER_REFRESH_TTL_DAYS=60
#CUSTOMER_REFRESH_GRACE_SECONDS=120
#CUSTOMER_REFRESH_UNCONFIRMED_SECONDS=600
# OTP policy (A3): code lifetime (s), resend wait (s), attempts per code, lockout (min), codes per phone per
# day, wrong codes per day, codes per device per day, codes per IP per day (carrier-grade NAT: high).
# Optional · defaults 120 / 60 / 5 / 15 / 10 / 10 / 10 / 1000.
#CUSTOMER_OTP_TTL_SECONDS=120
#CUSTOMER_OTP_RESEND_SECONDS=60
#CUSTOMER_OTP_MAX_ATTEMPTS=5
#CUSTOMER_OTP_LOCKOUT_MINUTES=15
#CUSTOMER_OTP_DAILY_LIMIT=10
#CUSTOMER_OTP_DAILY_WRONG_LIMIT=10
#CUSTOMER_OTP_DEVICE_DAILY_LIMIT=10
#CUSTOMER_OTP_IP_DAILY_LIMIT=1000
# Global SMS circuit breaker: codes per hour across all phones (above it: 503 sms_unavailable + alert
# otp.budget_tripped). Optional · default 500.
#SMS_GLOBAL_HOURLY_LIMIT=500
# Verification token lifetime (s), minimum customer password length, dormant-account reset (days).
# Optional · defaults 600 / 8 / 180.
#CUSTOMER_VERIFICATION_TTL_SECONDS=600
#CUSTOMER_PASSWORD_MIN_LENGTH=8
#CUSTOMER_DORMANT_DAYS=180
# Android SMS Retriever app hash (exactly 11 characters) appended to the OTP text. Optional · default empty.
#ANDROID_SMS_APP_HASH=
# Social sign-in ticket and nonce lifetimes (s). Optional · defaults 600 / 600.
#SOCIAL_TICKET_TTL_SECONDS=600
#SOCIAL_NONCE_TTL_SECONDS=600
# Saved addresses per customer. Optional · default 10.
#ADDRESS_MAX_PER_CUSTOMER=10
# Cart lines, quantity per line, open unpaid orders per customer, minimum payable (so'm). Optional · defaults
# 30 / 10 / 1 / 1000.
#CART_MAX_LINES=30
#CART_MAX_QTY_PER_LINE=10
#CHECKOUT_MAX_OPEN_ORDERS=1
#CHECKOUT_MIN_PAYABLE=1000
# Seconds after reservation_expires_at during which a payment started before it may still complete.
# Optional · default 300 (CLICK_INFLIGHT_SECONDS must not exceed it).
#PAYMENT_IN_FLIGHT_GRACE_SECONDS=300
# Where the provider page sends the customer back (the app's https universal link; ?order_id= is appended) and
# the custom-scheme fallback. Optional · defaults below. Must match the mobile app's associated domains.
#PAYMENT_RETURN_URL=https://glowderma.uz/pay/return
#PAYMENT_RETURN_FALLBACK_URL=glowderma://payment/return
# Customer website return page (B-W1) · optional · https; {order_id} required, {lang}, {locale_prefix} ("" | /ru | /en).
#PAYMENT_WEB_RETURN_URL=https://glowderma.uz{locale_prefix}/buyurtmalar/{order_id}?paid=1
# QR token lifetime (s), live tokens per customer (1 or 2), failed POS key attempts per IP per minute.
# Optional · defaults 60 / 2 / 20.
#QR_TOKEN_TTL_SECONDS=60
#QR_MAX_LIVE_TOKENS=2
#POS_FAILED_AUTH_PER_IP_PER_MIN=20
# Booking: minimum lead (min), horizon (days), open bookings per customer, cancel lead (min).
# Optional · defaults 60 / 30 / 3 / 0.
#BOOKING_MIN_LEAD_MINUTES=60
#BOOKING_HORIZON_DAYS=30
#BOOKING_MAX_OPEN_PER_CUSTOMER=3
#BOOKING_CANCEL_MIN_LEAD_MINUTES=0
# Stored "rejected:" webhook inbox rows per IP per minute for callbacks that fail authentication.
# Optional · default 10.
#WEBHOOK_REJECTED_PER_IP_PER_MIN=10

# =============================================================================================================
# 6. Mobile apps: Google / Apple sign-in ids, versions, store links
# =============================================================================================================
# Google client ids the app's ID tokens are issued for (iOS client id, web/server client id used by Android),
# comma separated. Optional · default empty (customer Google sign-in refuses every token). Not secret.
#GOOGLE_APP_CLIENT_IDS=change-me-ios.apps.googleusercontent.com,change-me-web.apps.googleusercontent.com
# Sign in with Apple: the iOS bundle id(s), comma separated. Optional · default empty = provider "apple" off.
#APPLE_BUNDLE_IDS=uz.glowderma.app
# Customer website social sign-in (B-W1) · optional: Google web client ids, Sign in with Apple JS Services IDs and
# the redirect URI their authorization uses (https; required with APPLE_SERVICES_IDS when OAUTH_MODE=live).
#GOOGLE_WEB_CLIENT_IDS=change-me-web.apps.googleusercontent.com
#APPLE_SERVICES_IDS=uz.glowderma.web
#APPLE_WEB_REDIRECT_URI=https://glowderma.uz/auth/apple/callback
# Apple developer team id and Sign in with Apple key id. Required when OAUTH_MODE=live and APPLE_BUNDLE_IDS is
# set. Not secret (identifiers).
#APPLE_TEAM_ID=change-me-team-id
#APPLE_KEY_ID=change-me-key-id
# The Sign in with Apple .p8 key (EC P-256, checked at boot) inside the mounted secrets directory. Required when
# OAUTH_MODE=live and APPLE_BUNDLE_IDS is set · secret (the file; this path is not). Copy the .p8 to
# $GLOWDERMA_SECRETS_DIR/apple-signin.p8 (group 10001, mode 0440).
#APPLE_PRIVATE_KEY_FILE=/run/secrets/glowderma/apple-signin.p8
# Minimum app versions (426 app_update_required below them). Optional · default 0.0.0 (no forced update).
#MIN_APP_VERSION_IOS=0.0.0
#MIN_APP_VERSION_ANDROID=0.0.0
# Store links of the update prompt. Optional · the App Store default is a placeholder id: set the real link
# before the app ships.
#APP_STORE_URL=https://apps.apple.com/app/id0000000000
#PLAY_STORE_URL=https://play.google.com/store/apps/details?id=uz.glowderma.app

# =============================================================================================================
# 7. Provider adapters: Billz, Click, Payme, BTS, Eskiz, FCM (docs/integrations/<provider>.md)
# =============================================================================================================
# Default mode of every provider (fake | live); each *_MODE below overrides it. Optional · default fake.
# Fake under the production settings (allowed: a WARNING at startup, listed by health/?ready=1 to the admin
# network) means: no online selling (Billz), no delivery (BTS), Click/Payme not offered and their callbacks
# refused (no money moves), no SMS delivered (nobody can register, reset or sign in on a new device), no push
# delivered. A live provider needs every value of its block; production refuses to start without them, and
# health/?ready=1 answers 503 while a live provider is not configured.
INTEGRATIONS_MODE=fake

# ---- Billz (POS/ERP: stock, online sales) --------------------------------------------------------------------
# fake | live. Optional · default INTEGRATIONS_MODE. Online selling requires live.
#BILLZ_MODE=live
# Integration key (Billz → Settings → Company → Integration keys). Required when BILLZ_MODE=live · secret.
#BILLZ_SECRET_KEY=change-me-billz-integration-key
# UUIDs from GET /v1/shop, GET /v1/cash-box, GET /v1/company-payment-type (the online/card type). Required
# when BILLZ_MODE=live · not secret · the all-zero UUID is refused.
#BILLZ_SHOP_ID=00000000-0000-0000-0000-000000000000
#BILLZ_CASHBOX_ID=00000000-0000-0000-0000-000000000000
#BILLZ_PAYMENT_TYPE_ID=00000000-0000-0000-0000-000000000000
# Documented public values; change only if Billz says so. Optional (https required when live).
#BILLZ_BASE_URL=https://api-admin.billz.ai
#BILLZ_PLATFORM_ID=7d4a4c38-dd84-4902-b744-0488b80a4c01
# Requests per second shared by every worker (0 < rate <= 2; Billz answers 429 above ~2/s). Optional · 1.5.
#BILLZ_RATE_LIMIT_PER_SECOND=1.5
# Connect / read timeouts in seconds (at most 30 / 60). Optional · defaults 5 / 30.
#BILLZ_CONNECT_TIMEOUT_SECONDS=5
#BILLZ_READ_TIMEOUT_SECONDS=30
# GET /v2/products page size (1..300). Optional · default 300.
#BILLZ_PAGE_SIZE=300
# A full sync hides missing products only when Billz listed at least this share of the previous full count
# (0 < r <= 1). Optional · default 0.8.
#BILLZ_FULL_SYNC_MIN_RATIO=0.8
# Billz product attribute or custom field holding the volume ("30 ml"). Optional · default empty (not synced).
#BILLZ_VOLUME_FIELD=
# Closed shift/cash box: retry interval (min, 1..1440) and how long it is waited for (h, 1..168) before the
# sale is dead-lettered "shift closed". Optional · defaults 15 / 36.
#BILLZ_SHIFT_RETRY_MINUTES=15
#BILLZ_SHIFT_RETRY_MAX_HOURS=36
# Stock freshness [O]: delta sync interval in seconds (60..3600; single-flight with admin imports).
#BILLZ_DELTA_SYNC_SECONDS=300
# [O] While Billz is live, cart writes and checkout re-read lines whose stock is older than this (60..86400).
#BILLZ_STOCK_MAX_AGE_SECONDS=900
# [O] If Billz cannot confirm such a line and its stock is older than this, checkout answers 503 (cart writes
# keep working). At least BILLZ_STOCK_MAX_AGE_SECONDS, at most 604800.
#BILLZ_STOCK_STALE_REFUSE_SECONDS=3600

# ---- Click (SHOP API callbacks; Merchant API status/reversal) ------------------------------------------------
# fake | live. Optional · default INTEGRATIONS_MODE.
#CLICK_MODE=live
# Issued by Click (merchant cabinet). Required in EVERY mode · secret (a fake Click still verifies Completes of
# transactions prepared while it was live). Until Click issues it: openssl rand -hex 16
CLICK_SECRET_KEY=change-me
# Numeric ids from the Click cabinet. Required when CLICK_MODE=live · not secret · "00000" is refused.
#CLICK_SERVICE_ID=00000
#CLICK_MERCHANT_ID=00000
#CLICK_MERCHANT_USER_ID=00000
# Pay page and Merchant API. Optional · defaults below (https required when live).
#CLICK_PAY_URL=https://my.click.uz/services/pay
#CLICK_MERCHANT_API_URL=https://api.click.uz/v2/merchant
# Optional IP allow-list of the SHOP API callbacks (CIDRs, comma separated; defence in depth). Default empty =
# any IP (the signature is always checked). Take the ranges from Click.
#CLICK_ALLOWED_IPS=
# Seconds a prepared Click payment counts as in flight (<= PAYMENT_IN_FLIGHT_GRACE_SECONDS). Optional · 120.
#CLICK_INFLIGHT_SECONDS=120

# ---- Payme (Merchant API JSON-RPC callbacks; checkout URL) ---------------------------------------------------
# fake | live. Optional · default INTEGRATIONS_MODE.
#PAYME_MODE=live
# Merchant API key from the Payme cabinet (the TEST_KEY in the sandbox). Required in EVERY mode · secret.
# Until Payme issues it: openssl rand -hex 16
PAYME_KEY=change-me
# Merchant (cash desk) id from the Payme cabinet. Required when PAYME_MODE=live · not secret.
#PAYME_MERCHANT_ID=change-me-payme-merchant-id
# true = the sandbox checkout https://test.paycom.uz (startup WARNING; health "sandbox"). Optional · false.
#PAYME_TEST_MODE=false
# Checkout host override. Optional · default https://checkout.paycom.uz (https required when live).
#PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# The account field configured in the cabinet. Optional · default order_id.
#PAYME_ACCOUNT_FIELD=order_id
# IP allow-list of the Merchant API callbacks (CIDRs, comma separated). Optional · default empty = any IP (the
# Basic auth key is always checked). Set Payme's published callback addresses before go-live.
#PAYME_ALLOWED_IPS=
# Send the fiscal "detail" in CheckPerformTransaction. Optional · default false.
#PAYME_FISCAL_DETAIL_ENABLED=false

# ---- BTS (delivery) -----------------------------------------------------------------------------------------
# fake | live. Optional · default INTEGRATIONS_MODE. Home delivery requires live (fake: pickup only).
#BTS_MODE=live
# Our webhook secret: BTS calls https://API_DOMAIN/api/v1/webhooks/bts/?token=<this>. Required in EVERY mode ·
# secret · >= 32 characters (hex keeps the URL clean). Generate: openssl rand -hex 32
BTS_WEBHOOK_SECRET=change-me
# Base URL. Optional · default https://api.bts.uz (take the real production URL from BTS; test host
# https://apitest.bts.uz:28345 is flagged as a sandbox). https required when live.
#BTS_BASE_URL=https://api.bts.uz
# API login and password. Required when BTS_MODE=live · the password is secret.
#BTS_LOGIN=change-me
#BTS_PASSWORD=change-me
# Sender block of every parcel. Required when BTS_MODE=live · not secret. The phone is +998XXXXXXXXX (the
# committed example number is refused); the city code is one of BTS's reference list, set explicitly.
#BTS_SENDER_NAME=Glow Derma
#BTS_SENDER_PHONE=+998901234567
#BTS_SENDER_ADDRESS=change-me sender address
#BTS_SENDER_CITY_CODE=change-me-city-code
# courier = a BTS courier collects at the sender address; branch = staff bring parcels to the branch below
# (then required). Optional · default courier.
#BTS_PICKUP_TYPE=courier
#BTS_SENDER_BRANCH_CODE=change-me-branch-code
# clientId prefix per environment sharing one BTS account (letters, digits, _ -, <= 16, not ending in a digit;
# e.g. stg- on staging). Optional · default empty (the bare order id).
#BTS_CLIENT_ID_PREFIX=
# ready_to_take of created parcels; default parcel weight (g). Optional · defaults true / 1000.
#BTS_READY_TO_TAKE=true
#BTS_DEFAULT_PARCEL_WEIGHT_G=1000
# Polling fallback: parcels whose last status is older than this (min) are polled, at most BATCH parcels and
# MAX_SECONDS per run, stopping after N consecutive transport failures. Optional · 30 / 100 / 300 / 3.
#BTS_POLL_STALE_MINUTES=30
#BTS_POLL_BATCH=100
#BTS_POLL_MAX_SECONDS=300
#BTS_POLL_MAX_CONSECUTIVE_FAILURES=3

# ---- Eskiz (SMS) --------------------------------------------------------------------------------------------
# fake | live. Optional · default INTEGRATIONS_MODE. SMS sign-up, password reset and new-device sign-in
# require live (fake delivers nothing under the production settings).
#ESKIZ_MODE=live
# Cabinet e-mail and password. Required when ESKIZ_MODE=live · the password is secret.
#ESKIZ_EMAIL=change-me@example.uz
#ESKIZ_PASSWORD=change-me-eskiz-password
# Approved sender nickname. Required when ESKIZ_MODE=live (production refuses 4546, Eskiz's shared test sender,
# which is also the default).
#ESKIZ_SENDER=change-me-approved-sender
# Optional · default https://notify.eskiz.uz/api (https required when live).
#ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# Delivery reports URL (https). Optional · leave empty: no receiving endpoint exists yet.
#ESKIZ_CALLBACK_URL=

# ---- E-mail (OTP codes by e-mail) --------------------------------------------------------------------------
# fake | smtp. Optional · default fake (WARNING at startup, flagged in health/?ready=1: no e-mail is delivered,
# so nobody can sign up, reset or verify by e-mail). smtp = any SMTP relay (the provider is chosen here).
#EMAIL_MODE=smtp
# Relay host and port. EMAIL_HOST required when EMAIL_MODE=smtp · port optional, default 587.
#EMAIL_HOST=change-me-smtp.example.uz
#EMAIL_PORT=587
# Relay account; both or neither (an IP-allow-listed relay). Optional · the password is secret.
#EMAIL_HOST_USER=change-me@example.uz
#EMAIL_HOST_PASSWORD=change-me-smtp-password
# STARTTLS (587) or implicit TLS (465): production with smtp requires exactly one. Optional · true / false.
#EMAIL_USE_TLS=true
#EMAIL_USE_SSL=false
# Sender, "addr" or "Name <addr>". Required when EMAIL_MODE=smtp (an address of a domain the relay may send for).
#EMAIL_FROM=Glow Derma <change-me@glowderma.uz>
# Seconds per SMTP conversation (1..60). Optional · default 10.
#EMAIL_TIMEOUT=10
# Codes per hour before 503 email_unavailable. Optional · default 500.
#EMAIL_GLOBAL_HOURLY_LIMIT=500
# E-mail codes per client IP per hour before 429 otp_network_limit (one IP cannot exhaust the budget above).
# Optional · default 20.
#EMAIL_OTP_IP_HOURLY_LIMIT=20
# Attaching a phone or an e-mail within this many seconds of signing in needs no password or code (0..3600).
# Optional · default 600.
#CUSTOMER_REAUTH_FRESH_SECONDS=600

# ---- FCM (push notifications) -------------------------------------------------------------------------------
# fake | live. Optional · default INTEGRATIONS_MODE. Pushes require live.
#FCM_MODE=live
# Firebase project id (lower case, 6–30 characters). Required when FCM_MODE=live · not secret.
#FCM_PROJECT_ID=change-me-firebase-project
# Service-account JSON key (RSA private_key, role "Firebase Cloud Messaging API Admin") inside the mounted
# secrets directory, checked at boot by api, worker and beat (never echoed). Required when FCM_MODE=live ·
# secret (the file). Copy it to $GLOWDERMA_SECRETS_DIR/fcm-service-account.json (group 10001, mode 0440).
#FCM_CREDENTIALS_FILE=/run/secrets/glowderma/fcm-service-account.json
# Recipients per campaign.send_batch outbox message. Optional · default 500.
#CAMPAIGN_BATCH_SIZE=500

# =============================================================================================================
# 8. Alerts (docs/ops/monitoring.md §1)
# =============================================================================================================
# Alert webhook: compact signed JSON POST per alert (ids and counts only). Optional · default empty = no
# webhook (the ERROR log lines stay). https only; treat the URL as a secret (it often embeds a token). The
# receiver must be hosted in Uzbekistan or receive no personal data (docs/ops/compliance.md §1.2).
#ALERT_WEBHOOK_URL=https://alerts.example.invalid/hooks/glowderma
# HMAC-SHA256 key of the X-GD-Signature header. Required when ALERT_WEBHOOK_URL is set · secret · >= 32
# characters. Generate: openssl rand -hex 32
#ALERT_WEBHOOK_SECRET=change-me
# One alert per event (and scope) per window (min, 1..1440). Optional · default 30.
#ALERT_DEDUPE_MINUTES=30
# The "env" of every alert. Optional · default production (set staging on a staging host).
#ALERT_ENV=production

# =============================================================================================================
# 9. Retention (docs/ops/compliance.md §4), purged nightly in batches
# =============================================================================================================
# Raw provider callbacks (personal data) and done outbox messages, in days (1..3650; dead messages are kept
# until resolved); rows per batch (100..10000); hours after which a deferred message of a topic without its
# own window counts as stuck (1..168). Optional · defaults 180 / 30 / 1000 / 24. 180 days is contractual (T13).
#WEBHOOK_INBOX_RETENTION_DAYS=180
#OUTBOX_RETENTION_DAYS=30
#RETENTION_BATCH_SIZE=1000
#OUTBOX_DEFERRAL_WINDOW_HOURS=24

# =============================================================================================================
# 10. Nightly consistency report (03:40 Tashkent; docs/ops/monitoring.md §3)
# =============================================================================================================
# Ids reported per check (1..200), look-back of K1/K2 (days, 1..90), and the thresholds of K1 Billz sale not
# recorded (min), K2 pending payment (min past reservation + grace), K3 refund open (h), K4 no BTS parcel (min)
# / no new BTS status (h), K5 late capture not refunded (h), K6 outbox dead (h) / overdue (min).
# Optional · defaults 20 / 7 / 120 / 60 / 24 / 60 / 48 / 24 / 24 / 60.
#CONSISTENCY_SAMPLE_SIZE=20
#CONSISTENCY_LOOKBACK_DAYS=7
#CONSISTENCY_BILLZ_SALE_MINUTES=120
#CONSISTENCY_PAYMENT_PENDING_MINUTES=60
#CONSISTENCY_REFUND_OPEN_HOURS=24
#CONSISTENCY_SHIPMENT_MINUTES=60
#CONSISTENCY_PARCEL_UNTRACKED_HOURS=48
#CONSISTENCY_LATE_CAPTURE_HOURS=24
#CONSISTENCY_OUTBOX_DEAD_HOURS=24
#CONSISTENCY_OUTBOX_OVERDUE_MINUTES=60

# Session list location (B-W1) · optional: path of a GeoIP City .mmdb (MaxMind GeoLite2-City or DB-IP City Lite)
# inside the containers; empty = no location ("—"). No online lookup. Put the file in GLOWDERMA_SECRETS_DIR
# (already mounted read-only at /run/secrets/glowderma; group 10001, mode 0440) and replace it monthly with an
# atomic rename (copy to a temp name in the same directory, then mv): the api reopens it within a minute.
#GEOIP_CITY_DB=/run/secrets/glowderma/GeoLite2-City.mmdb
