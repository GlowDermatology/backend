# Production .env for compose.prod.yaml (copy to ./.env next to compose.prod.yaml, chmod 600, never commit).
# Compose reads it for ${...} interpolation and passes it to the api/worker/beat containers (env_file).
# Runbook: docs/ops/deploy.md.

# ---- Domains (Caddy edge, frontend build, Django hosts) ------------------------------------------------
SITE_DOMAIN=glowderma.uz
ADMIN_DOMAIN=admin.glowderma.uz
API_DOMAIN=api.glowderma.uz
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@glowderma.uz

# ---- Secrets (generate each; see docs/ops/deploy.md "Secrets") ----------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Shared by Django and the Next BFF (compose passes it to the frontend as GLOWDERMA_INTERNAL_SECRET).
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=change-me
# JSON {kid: base64url(32 random bytes)}; rotate by adding a new kid, switching JWT_ACTIVE_KID, and removing the
# old kid after the access-token lifetime has passed.
# python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
JWT_SIGNING_KEYS={"k1":"change-me"}
JWT_ACTIVE_KID=k1
# Hex only (it is embedded in DATABASE_URL by compose.prod.yaml): openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# ---- Set by compose.prod.yaml: do NOT define here ------------------------------------------------------
# DJANGO_SETTINGS_MODULE, DATABASE_URL, REDIS_URL, CELERY_BROKER_URL, ALLOWED_HOSTS, ADMIN_API_ALLOWED_NETS,
# TRUSTED_PROXIES, PUBLIC_MEDIA_BASE_URL, GIT_SHA (export GIT_SHA / FRONTEND_GIT_SHA in the shell when building).

# ---- Provider adapters ---------------------------------------------------------------------------------
# fake = deterministic in-process stubs: nothing reaches Billz, BTS, Click, Payme, Eskiz, FCM, Google or
# Facebook. Use fake only for staging/demo; real customers need live adapters and credentials.
INTEGRATIONS_MODE=fake
OAUTH_MODE=fake
#BILLZ_MODE=fake
#FCM_MODE=fake
#CAMPAIGN_BATCH_SIZE=500
# Live staff social sign-in (OAUTH_MODE=live) requires all of:
#OAUTH_REDIRECT_URI=https://admin.glowderma.uz/admin/auth/callback
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
#GOOGLE_ALLOWED_HD=
#STAFF_GOOGLE_AUTOLINK=false
#FACEBOOK_APP_ID=
#FACEBOOK_APP_SECRET=

# ---- Tuning --------------------------------------------------------------------------------------------
# Gunicorn gthread: processes x threads per api container.
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
# Celery worker processes.
CELERY_CONCURRENCY=2
LOG_LEVEL=INFO
# Django admin at /django-admin/ (reachable only from the private network, e.g. through an SSH tunnel).
DJANGO_ADMIN_ENABLED=false
# The edge already sends Strict-Transport-Security; keep Django's off to avoid two policies.
SECURE_HSTS_SECONDS=0
# Per-scope throttle overrides (contract §1.9), JSON object of DRF rates.
#THROTTLE_RATES={"login":"30/min","staff":"1200/min"}
# Path of the frontend repository checkout used as the frontend image build context.
#FRONTEND_CONTEXT=../frontend
