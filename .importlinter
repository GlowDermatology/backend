[importlinter]
root_package = glowderma

[importlinter:contract:layers]
name = module layering (AGENTS.md "Architecture rules")
type = layers
layers =
    glowderma.reporting | glowderma.customers
    glowderma.notifications
    glowderma.commerce | glowderma.appointments | glowderma.assistant
    glowderma.payments | glowderma.delivery | glowderma.loyalty | glowderma.catalog | glowderma.professionals
    glowderma.site_config
    glowderma.accounts
    glowderma.integrations
    glowderma.core
# Test packages may build rows of upper layers (loyalty tests need orders/products): the layering applies to
# production code; tests of a lower module may import any module's test factories.
ignore_imports =
    glowderma.*.tests.** -> glowderma.**

# The whole accounts app, bottom to top. Each module imports only the layers below it; siblings on one line
# never import each other. Anything new in accounts must be placed here (exhaustive).
[importlinter:contract:accounts-modules]
name = accounts: the app's own layering
type = layers
containers =
    glowderma.accounts
exhaustive = true
exhaustive_ignores =
    tests
    migrations
layers =
    apps
    admin | management | seeds | tasks
    api | console
    authentication
    services
    mfa | selectors
    second_factor | security | request_facts | console_sessions
    permissions | tokens
    models
    errors | media | topics | schema

# accounts.models is a package (models/__init__.py is the facade Django loads); one subject per module,
# all of them above the shared defaults that migrations reference.
[importlinter:contract:accounts-models]
name = accounts.models: subject modules above the shared defaults
type = layers
containers =
    glowderma.accounts.models
exhaustive = true
layers =
    staff | customers | devices | otp_codes | auth_sessions
    defaults

# accounts.security holds the brute-force primitives: the lockout ladder and the address budget both count
# with the atomic counter, and nothing in the package reaches the API, console or services layers.
[importlinter:contract:accounts-security]
name = accounts.security: lockouts above the atomic counter
type = layers
containers =
    glowderma.accounts.security
exhaustive = true
layers =
    login_lockout | address_budget | identifiers
    counters

[importlinter:contract:accounts-security-is-a-primitive]
name = accounts.security, second_factor and console_sessions never import the layers built on them
type = forbidden
source_modules =
    glowderma.accounts.security
    glowderma.accounts.second_factor
    glowderma.accounts.console_sessions
forbidden_modules =
    glowderma.accounts.api
    glowderma.accounts.console
    glowderma.accounts.services
    glowderma.accounts.mfa

# accounts.second_factor: TOTP devices and recovery codes of the console and panel scopes (the facade is its
# __init__); everything stands on the scope definitions.
[importlinter:contract:accounts-second-factor]
name = accounts.second_factor: TOTP and provisioning above recovery codes above the scopes
type = layers
containers =
    glowderma.accounts.second_factor
exhaustive = true
layers =
    totp | provisioning | reset
    recovery_codes
    scopes

# accounts.selectors: three independent read subjects behind the facade.
[importlinter:contract:accounts-selectors]
name = accounts.selectors subjects are independent
type = independence
modules =
    glowderma.accounts.selectors.staff_directory
    glowderma.accounts.selectors.customer_sessions
    glowderma.accounts.selectors.customer_dashboard

# accounts.authentication: the two JWT audiences above the shared header parsing (the facade is its
# __init__, the dotted path settings and the OpenAPI extensions name).
[importlinter:contract:accounts-authentication]
name = accounts.authentication: JWT audiences above the header parsing
type = layers
containers =
    glowderma.accounts.authentication
exhaustive = true
layers =
    staff_jwt | customer_jwt
    bearer | device_headers

# accounts.mfa: the admin panel's optional TOTP (the facade is its __init__); enrolment and the sign-in
# challenge stand on the factor check, the lockout and the audit trail.
[importlinter:contract:accounts-mfa]
name = accounts.mfa: enrolment and challenges above factors above the lockout
type = layers
containers =
    glowderma.accounts.mfa
exhaustive = true
layers =
    enrolment | challenges
    factors
    lockout
    audit_trail | state
    policy

# accounts.console: the ops console's sign-in. Routes above views and the middleware, above the forms, the
# lockout audit and the access service, above the audit trail, the notices and the fixed paths.
[importlinter:contract:accounts-console]
name = accounts.console: urls above views above forms and access above events and notices
type = layers
containers =
    glowderma.accounts.console
exhaustive = true
layers =
    urls
    views | middleware
    forms | lockouts | access
    events | notices | paths

[importlinter:contract:accounts-console-views]
name = accounts.console.views: one module per step above what the steps share
type = layers
containers =
    glowderma.accounts.console.views
exhaustive = true
layers =
    password | verify | recovery | enrolment | session | csrf
    code_steps
    rendering

# accounts.tasks: the outbox handlers and the cleanup job, above the shared payload reading and rendering.
[importlinter:contract:accounts-tasks]
name = accounts.tasks: handlers above the shared payload reading and message rendering
type = layers
containers =
    glowderma.accounts.tasks
exhaustive = true
layers =
    otp_delivery | email_notices | apple_revocation | staff_password_links | session_replaced_push | auth_cleanup
    outbox_payloads | message_rendering

# accounts.admin: the ops console pages, one independent module per subject (the package imports them all).
[importlinter:contract:accounts-admin]
name = accounts.admin subjects are independent
type = independence
modules =
    glowderma.accounts.admin.staff
    glowderma.accounts.admin.auth_sessions
    glowderma.accounts.admin.customer_records
    glowderma.accounts.admin.otp_devices

# accounts.api.throttles: the audience throttles above the per-customer and per-device bases, above the
# shared base and the request idents (the facade is its __init__).
[importlinter:contract:accounts-throttles]
name = accounts.api.throttles: audience throttles above the bases
type = layers
containers =
    glowderma.accounts.api.throttles
exhaustive = true
layers =
    customer_auth | public | staff | refresh_misses
    customer
    base | idents

# accounts.api.admin: routes above the views, above the response bodies, above the serializers; inside each
# package, one module per subject above the shared pieces.
[importlinter:contract:accounts-api-admin]
name = accounts.api.admin: urls above views above their schemas, payloads and serializers
type = layers
containers =
    glowderma.accounts.api.admin
exhaustive = true
layers =
    urls | staff_urls
    views
    schemas
    payloads
    serializers

[importlinter:contract:accounts-api-admin-views]
name = accounts.api.admin.views: one independent module per subject
type = independence
modules =
    glowderma.accounts.api.admin.views.auth_sessions
    glowderma.accounts.api.admin.views.profile
    glowderma.accounts.api.admin.views.passwords
    glowderma.accounts.api.admin.views.two_factor
    glowderma.accounts.api.admin.views.social
    glowderma.accounts.api.admin.views.staff_members

[importlinter:contract:accounts-api-admin-schemas]
name = accounts.api.admin.schemas: one module per views module above the shared declarations
type = layers
containers =
    glowderma.accounts.api.admin.schemas
exhaustive = true
layers =
    auth_sessions | profile | passwords | two_factor | social | staff_members
    common

[importlinter:contract:accounts-api-admin-serializers]
name = accounts.api.admin.serializers: subjects above the field factories
type = layers
containers =
    glowderma.accounts.api.admin.serializers
exhaustive = true
layers =
    auth_sessions | staff_management
    profile | passwords | social | two_factor | staff_directory
    fields

# accounts.services is a package (services/__init__.py is the facade callers import). Its submodules form
# layers of their own, so the split stays acyclic and each name keeps a single home.
[importlinter:contract:accounts-services-packages]
name = accounts.services: staff | customer above otp above common
type = layers
containers =
    glowderma.accounts.services
layers =
    staff | customer
    otp
    common

[importlinter:contract:accounts-services-customer]
name = accounts.services.customer modules
type = layers
containers =
    glowderma.accounts.services.customer
exhaustive = true
layers =
    lifecycle
    device_registration | refresh | addresses | profile | identities | session_revocation
    auth_sessions
    devices | locks | session_activity

[importlinter:contract:accounts-services-otp]
name = accounts.services.otp modules
type = layers
containers =
    glowderma.accounts.services.otp
layers =
    verification
    issuance
    limits
    targets
    channels

[importlinter:contract:accounts-services-staff]
name = accounts.services.staff modules
type = layers
containers =
    glowderma.accounts.services.staff
exhaustive = true
layers =
    members | social | two_factor | sign_in | sign_out | password_change
    password_links
    auth_sessions | credentials
    messages | locks

# The modules that import the services facade must never be imported back by its submodules.
[importlinter:contract:accounts-services-no-back-imports]
name = accounts.services submodules never import the modules built on them
type = forbidden
source_modules =
    glowderma.accounts.services.common
    glowderma.accounts.services.customer
    glowderma.accounts.services.otp
    glowderma.accounts.services.staff
forbidden_modules =
    glowderma.accounts.api
    glowderma.accounts.console
    glowderma.accounts.authentication
    glowderma.accounts.selectors
    glowderma.accounts.tasks
    glowderma.accounts.seeds
    glowderma.accounts.admin
    glowderma.accounts.management

# customers.api: per audience, routes above the views, above their OpenAPI declarations and response bodies,
# above the serializers; inside each package, one module per subject above the shared pieces.
[importlinter:contract:customers-api-customer]
name = customers.api.customer: urls above views above schemas and payloads above serializers
type = layers
containers =
    glowderma.customers.api.customer
exhaustive = true
layers =
    urls
    views
    schemas | payloads
    serializers

[importlinter:contract:customers-api-customer-views]
name = customers.api.customer.views: one module per subject above the shared base
type = layers
containers =
    glowderma.customers.api.customer.views
exhaustive = true
layers =
    auth | social | me | me_social | contacts | addresses | sessions | catalog
    common

[importlinter:contract:customers-api-customer-schemas]
name = customers.api.customer.schemas: one module per views module above the shared declarations
type = layers
containers =
    glowderma.customers.api.customer.schemas
exhaustive = true
layers =
    auth | social | me | me_social | contacts | addresses | sessions | catalog
    common | delete_body

[importlinter:contract:customers-api-customer-serializers]
name = customers.api.customer.serializers: subjects above the profile, its addresses and the field factories
type = layers
containers =
    glowderma.customers.api.customer.serializers
exhaustive = true
layers =
    auth | social | contacts | sessions | catalog
    me
    addresses
    fields

[importlinter:contract:customers-api-admin]
name = customers.api.admin: urls above views above schemas above serializers
type = layers
containers =
    glowderma.customers.api.admin
exhaustive = true
layers =
    urls
    views
    schemas
    serializers

[importlinter:contract:customers-api-admin-views]
name = customers.api.admin.views: one independent module per subject
type = independence
modules =
    glowderma.customers.api.admin.views.customers
    glowderma.customers.api.admin.views.cashback
    glowderma.customers.api.admin.views.sessions

# customers.services is a package (services/__init__.py is the facade callers import): the signed-in writes
# above social sign-in, above the sign-in flows, above what they all share.
[importlinter:contract:customers-services]
name = customers.services: me above social above auth above common
type = layers
containers =
    glowderma.customers.services
exhaustive = true
layers =
    me | cashback
    social
    auth
    common

[importlinter:contract:customers-services-common]
name = customers.services.common: identities and terms above passwords and the trail above identifiers
type = layers
containers =
    glowderma.customers.services.common
exhaustive = true
layers =
    identities | published_terms
    passwords | trail | results
    identifiers

[importlinter:contract:customers-services-auth]
name = customers.services.auth: the flows above the dormant-account rule
type = layers
containers =
    glowderma.customers.services.auth
exhaustive = true
layers =
    recovery | login | registration
    dormancy

[importlinter:contract:customers-services-social]
name = customers.services.social: sign-in and completion above the ticket, the token checks and revocation
type = layers
containers =
    glowderma.customers.services.social
exhaustive = true
layers =
    completion | sign_in
    tickets | tokens | apple_revocation

[importlinter:contract:customers-services-me]
name = customers.services.me: social links above the other writes above re-authentication
type = layers
containers =
    glowderma.customers.services.me
exhaustive = true
layers =
    social_links
    contacts | password | deletion | profile | addresses
    reauth

[importlinter:contract:customers-selectors]
name = customers.selectors: admin, account and catalog reads above the shared helpers
type = layers
containers =
    glowderma.customers.selectors
exhaustive = true
layers =
    admin | account | catalog
    common
