# Uzbek (Latin) strings of the Django admin's JavaScript (date/time shortcuts, calendar, select filters) that
# Django's own uz djangojs catalog leaves untranslated; JavaScriptCatalog merges LOCALE_PATHS over it.
# Compile with `manage.py compile_locale` (stdlib, no GNU gettext); commit the .mo with it.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: uz\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Today (%(date)s)"
msgstr "Bugun (%(date)s)"

msgid "Yesterday (%(date)s)"
msgstr "Kecha (%(date)s)"

msgid "Tomorrow (%(date)s)"
msgstr "Ertaga (%(date)s)"

msgid "Previous (%(month)s %(year)s)"
msgstr "Oldingi oy (%(month)s %(year)s)"

msgid "Next (%(month)s %(year)s)"
msgstr "Keyingi oy (%(month)s %(year)s)"

msgid "%(month)s %(day)s, %(year)s"
msgstr "%(day)s-%(month)s, %(year)s"

msgid "%s (today)"
msgstr "%s (bugun)"

msgid "%s (current selection)"
msgstr "%s (tanlangan)"

msgid "%s (today, current selection)"
